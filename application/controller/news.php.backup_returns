<?php
/**
 * NEWS Controller
 * 뉴스 컨트롤러
 * 
 * helpers.php 및 _news_optimization.func.php는 index.php에서 전역 로드됨
 */

class News extends Controller {
    
    private $newsModel;
    
    public function __construct() {
        $this->newsModel = $this->model('NewsModel');
    }
    
    /**
     * 뉴스 라우팅
     * URL: /news/{newsId} 또는 /news/{newsId}/{action}/{param}
     */
    public function index($newsId = null, $action = null, $param = null) {
        // 디버깅: 모든 파라미터 로깅
        error_log("NEWS Route Debug - newsId: " . var_export($newsId, true) . ", action: " . var_export($action, true) . ", param: " . var_export($param, true));
        error_log("NEWS Route Debug - func_num_args: " . func_num_args());
        for ($i = 0; $i < func_num_args(); $i++) {
            error_log("NEWS Route Debug - arg[$i]: " . var_export(func_get_arg($i), true));
        }
        
        // newsId가 없으면 홈으로
        if (!$newsId) {
            redirect('/');
        }
        
        // action에 따라 분기
        if ($action === 'view' && $param) {
            return $this->viewPost($newsId, $param);
        } elseif ($action === 'write' || $action === 'write-process') {
            if ($param === 'process' || $action === 'write-process') {
                return $this->writeProcess($newsId);
            }
            return $this->write($newsId);
        } elseif ($action === 'edit' || $action === 'edit-process') {
            if ($action === 'edit-process') {
                return $this->editProcess($newsId, $param);
            }
            $subAction = func_num_args() > 3 ? func_get_arg(3) : null;
            if ($subAction === 'process') {
                return $this->editProcess($newsId, $param);
            }
            return $this->edit($newsId, $param);
        } elseif ($action === 'delete' && $param) {
            return $this->delete($newsId, $param);
        } elseif ($action === 'like' && $param) {
            return $this->toggleLike($newsId, $param);
        } elseif ($action === 'download' && $param) {
            return $this->download($param);
        } elseif ($action === 'comment' && is_numeric($param)) {
            // /news/{newsId}/comment/{postUid} (신규 형식)
            $postUid = $param;
            $commentUid = func_num_args() > 3 ? func_get_arg(3) : null;
            $commentAction = func_num_args() > 4 ? func_get_arg(4) : null;
            
            if ($commentUid && $commentAction === 'delete') {
                return $this->commentDelete($newsId, $postUid, $commentUid);
            } elseif ($commentUid && $commentAction === 'edit') {
                return $this->commentEdit($newsId, $postUid, $commentUid);
            } else {
                return $this->commentWrite($newsId, $postUid);
            }
        } elseif (is_numeric($action) && $param === 'comment') {
            // /news/{newsId}/{postUid}/comment[/{commentUid}/{action}]
            $postUid = $action;
            $commentUid = func_num_args() > 3 ? func_get_arg(3) : null;
            $commentAction = func_num_args() > 4 ? func_get_arg(4) : null;
            
            error_log("Comment Route Detected - postUid: $postUid, commentUid: $commentUid, commentAction: $commentAction");
            
            if ($commentUid && $commentAction === 'delete') {
                // /news/{newsId}/{postUid}/comment/{commentUid}/delete
                error_log("Calling commentDelete($newsId, $postUid, $commentUid)");
                return $this->commentDelete($newsId, $postUid, $commentUid);
            } elseif ($commentUid && $commentAction === 'edit') {
                // /news/{newsId}/{postUid}/comment/{commentUid}/edit
                return $this->commentEdit($newsId, $postUid, $commentUid);
            } else {
                // /news/{newsId}/{postUid}/comment (작성)
                return $this->commentWrite($newsId, $postUid);
            }
        } elseif (is_numeric($action) && $param === 'comments') {
            // /news/{newsId}/{postUid}/comments - 댓글 목록 조회 (구 형식)
            $postUid = $action;
            return $this->getComments($newsId, $postUid);
        } elseif ($action === 'comments' && is_numeric($param)) {
            // /news/{newsId}/comments/{postUid} - 댓글 목록 조회 (신규 형식)
            $postUid = $param;
            return $this->getComments($newsId, $postUid);
        }
        
        // 기본: 뉴스 목록
        $page = is_numeric($action) ? $action : 1;
        return $this->listPosts($newsId, $page);
    }
    
    /**
     * 뉴스 목록
     */
    private function listPosts($newsId, $page = 1) {
        // 뉴스 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        if (!$news) {
            redirect('/');
        }
        
        // 권한 체크
        if ($news['read_level'] > ($_SESSION['level'] ?? 0)) {
            redirect('/member/login?redirect=/news/' . $newsId);
        }
        
        // 검색 파라미터
        $category = $this->get('category');
        $search = $this->get('search');
        
        // 뉴스 목록
        $perPage = $news['page_rows'];
        $result = $this->newsModel->getPostList($newsId, $page, $perPage, $category, $search);
        
        $data = [
            'title' => $news['news_name'],
            'news' => $news,
            'notices' => $result['notices'],
            'posts' => $result['posts'],
            'total' => $result['total'],
            'current_page' => (int)$page,
            'total_pages' => $result['pages'],
            'category' => $category,
            'search' => $search
        ];
        
        $this->view('news/' . $news['news_skin'] . '/list', $data);
    }
    
    /**
     * 뉴스 상세보기
     * URL: /news/{newsId}/view/{uid}
     */
    public function viewPost($newsId, $uid) {
        // 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        if (!$news) {
            redirect('/');
        }
        
        // 권한 체크
        if ($news['read_level'] > ($_SESSION['level'] ?? 0)) {
            redirect('/member/login?redirect=/news/' . $newsId . '/view/' . $uid);
        }
        
        // 뉴스 조회
        $post = $this->newsModel->getPost($uid);
        
        if (!$post || $post['news_id'] !== $newsId) {
            redirect('/news/' . $newsId);
        }
        
        // 댓글 조회
        $comments = $this->newsModel->getComments($uid);
        
        // 이전/다음 글
        $prevNext = $this->newsModel->getPrevNext($newsId, $uid);
        
        // 첨부파일 조회
        $files = $this->newsModel->getPostFiles($uid);
        
        // 현재 사용자의 좋아요 상태 확인
        $userLiked = false;
        if (isLoggedIn()) {
            $like = getUidData(
                "SELECT uid FROM post_likes WHERE post_uid = ? AND member_uid = ?",
                [$uid, $_SESSION['user_id']]
            );
            $userLiked = !empty($like);
        }
        
        $data = [
            'title' => $post['title'],
            'board' => $news,
            'news' => $news,  // ✅ view에서 $news 변수 사용을 위해 추가
            'post' => $post,
            'comments' => $comments,
            'prev' => $prevNext['prev'],
            'next' => $prevNext['next'],
            'files' => $files,
            'user_liked' => $userLiked
        ];
        
        $this->view('news/' . $news['news_skin'] . '/view', $data);
    }
    
    /**
     * 글쓰기 폼
     */
    public function write($newsId = null) {
        // newsId가 없으면 404
        if (!$newsId) {
            $this->show404();
            return;
        }
        
        // 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        if (!$news) {
            $this->show404();
            return;
        }
        
        // 권한 체크
        if ($news['write_level'] > ($_SESSION['level'] ?? 0)) {
            redirect('/member/login?redirect=/news/' . $newsId . '/write');
        }
        
        $data = [
            'title' => '글쓰기 - ' . $news['news_name'],
            'board' => $news,
            'news' => $news,  // View에서 $news 사용
            'mode' => 'write'
        ];
        
        $this->view('news/' . $news['news_skin'] . '/write', $data);
    }
    
    /**
     * 글쓰기 처리
     */
    public function writeProcess($newsId) {
        // JSON 응답을 위해 에러 표시 끄기
        ini_set('display_errors', 0);
        error_reporting(E_ALL);
        
        try {
            if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
                redirect('/news/' . $newsId);
            }
            
            // 뉴스 정보
            $news = $this->newsModel->getNewsInfo($newsId);
            
            if (!$news) {
                $this->json(['success' => false, 'message' => '존재하지 않는 뉴스입니다.'], 404);
                return;
            }
        
        // 권한 체크
        if ($news['write_level'] > ($_SESSION['level'] ?? 0)) {
            $this->json(['success' => false, 'message' => '뉴스등록 권한이 없습니다.'], 403);
            return;
        }
        
        // 입력 데이터
        $subject = cleanInput($this->post('subject'));
        $content = cleanInput($this->post('content'));
        $category = cleanInput($this->post('category'));
        
        // 유효성 검사
        if (empty($subject) || empty($content)) {
            $this->json(['success' => false, 'message' => '제목과 내용을 입력해주세요.'], 400);
            return;
        }
        
        // 뉴스 데이터
        $postData = [
            'news_id' => $newsId,
            'title' => $subject,
            'content' => $content,
            'category' => $category,
            'name' => $_SESSION['nickname'] ?? ($this->post('writer') ?: '비회원'),
            'member_uid' => $_SESSION['user_id'] ?? null,
            'is_notice' => (isAdmin() && $this->post('is_notice') === 'Y') ? 'Y' : 'N',
            'is_secret' => ($this->post('use_secret') === 'Y') ? 'Y' : 'N'
        ];
        
        // 비회원 비밀번호
        if (!isLoggedIn()) {
            $writer = $this->post('writer');
            $password = $this->post('password');
            
            if (empty($writer)) {
                $this->json(['success' => false, 'message' => '작성자명을 입력해주세요.'], 400);
                return;
            }
            if (empty($password)) {
                $this->json(['success' => false, 'message' => '비밀번호를 입력해주세요.'], 400);
                return;
            }
            $postData['password'] = $password;
        }
        
        // 뉴스 작성
        try {
            $postId = $this->newsModel->createPost($postData);
            
            if (!$postId) {
                error_log("News createPost failed: postId is empty");
                error_log("Post data: " . print_r($postData, true));
                $this->json(['success' => false, 'message' => '뉴스 등록 중 오류가 발생했습니다. (DB Insert 실패)'], 500);
                return;
            }
        } catch (Exception $e) {
            error_log("News createPost exception: " . $e->getMessage());
            error_log("Stack trace: " . $e->getTraceAsString());
            $this->json(['success' => false, 'message' => '뉴스 등록 중 오류가 발생했습니다: ' . $e->getMessage()], 500);
            return;
        }
        
        // 파일 업로드 처리
        if ($news['use_upload'] === 'Y' && !empty($_FILES['files']['name'][0])) {
            require_once __DIR__ . '/../libs/FileUpload.php';
            $uploader = new FileUpload();
            $uploadedFiles = $uploader->upload($_FILES['files']);
            
            if (!empty($uploadedFiles)) {
                $this->newsModel->attachFiles($postId, $uploadedFiles, $newsId);
            }
        }
        
        // ✅ 최적화 테이블에 데이터 추가
        newsInsertOptimizationData(
            $newsId,
            $postId,
            $postData['member_uid'],
            $postData['category'],
            $postData['is_notice'],
            $postData['is_secret']
        );
        
        // ✅ Sitemap 캐시 무효화
        invalidateSitemapCache('news');
        
        $this->json([
            'success' => true,
            'message' => '뉴스가 등록되었습니다.',
            'redirect' => '/news/' . $newsId . '/view/' . $postId
        ]);
        
        } catch (Exception $e) {
            error_log("writeProcess Fatal Error: " . $e->getMessage());
            error_log("Stack trace: " . $e->getTraceAsString());
            $this->json([
                'success' => false,
                'message' => '처리 중 오류가 발생했습니다: ' . $e->getMessage()
            ], 500);
        } catch (Error $e) {
            error_log("writeProcess Fatal Error: " . $e->getMessage());
            error_log("Stack trace: " . $e->getTraceAsString());
            $this->json([
                'success' => false,
                'message' => '심각한 오류가 발생했습니다: ' . $e->getMessage()
            ], 500);
        }
    }
    
    /**
     * 글수정 폼
     */
    public function edit($newsId, $uid) {
        // 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        if (!$news) {
            redirect('/');
        }
        
        // 뉴스 조회
        $post = $this->newsModel->getPost($uid);
        
        if (!$post || $post['news_id'] !== $newsId) {
            redirect('/news/' . $newsId);
        }
        
        // 수정 권한 체크 (작성자 또는 관리자)
        $canEdit = false;
        if (isLoggedIn() && isset($_SESSION['user_id'])) {
            if ($post['member_uid'] == $_SESSION['user_id'] || isAdmin()) {
                $canEdit = true;
            }
        }
        
        if (!$canEdit) {
            redirect('/news/' . $newsId . '/view/' . $uid);
        }
        
        // 첨부 파일 목록
        $files = $this->newsModel->getPostFiles($uid);
        
        $data = [
            'title' => '글수정 - ' . $news['news_name'],
            'board' => $news,
            'news' => $news,  // View에서 $news 사용
            'post' => $post,
            'files' => $files,
            'mode' => 'edit'
        ];
        
        $this->view('news/' . $news['news_skin'] . '/write', $data);
    }
    
    /**
     * 글수정 처리
     */
    public function editProcess($newsId, $uid) {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            redirect('/news/' . $newsId);
        }
        
        // 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        // 뉴스 조회
        $post = $this->newsModel->getPost($uid);
        
        if (!$post || $post['news_id'] !== $newsId) {
            $this->json(['success' => false, 'message' => '존재하지 않는 뉴스입니다.'], 404);
        }
        
        // 수정 권한 체크
        $canEdit = false;
        if (isLoggedIn() && isset($_SESSION['user_id'])) {
            if ($post['member_uid'] == $_SESSION['user_id'] || isAdmin()) {
                $canEdit = true;
            }
        }
        
        if (!$canEdit) {
            $this->json(['success' => false, 'message' => '수정 권한이 없습니다.'], 403);
        }
        
        // 입력 데이터
        $updateData = [
            'title' => cleanInput($this->post('subject')),
            'content' => cleanInput($this->post('content')),
            'category' => cleanInput($this->post('category'))
        ];
        
        // 비밀글 설정 (체크박스 체크 여부)
        $updateData['is_secret'] = ($this->post('use_secret') === 'Y') ? 'Y' : 'N';
        
        // 관리자인 경우 공지사항 설정 가능
        if (isAdmin()) {
            $updateData['is_notice'] = ($this->post('is_notice') === 'Y') ? 'Y' : 'N';
        }
        
        // 수정 처리
        $result = $this->newsModel->updatePost($uid, $updateData);
        
        if ($result === false) {
            $this->json(['success' => false, 'message' => '수정 중 오류가 발생했습니다.'], 500);
        }
        
        // 기존 파일 삭제 처리
        $deleteFiles = $this->post('delete_files');
        if (!empty($deleteFiles)) {
            $this->newsModel->deleteFiles($uid, $deleteFiles);
        }
        
        // 파일 업로드 처리
        if ($news['use_upload'] === 'Y' && !empty($_FILES['files']['name'][0])) {
            require_once __DIR__ . '/../libs/FileUpload.php';
            $uploader = new FileUpload();
            $uploadedFiles = $uploader->upload($_FILES['files']);
            
            if (!empty($uploadedFiles)) {
                $this->newsModel->attachFiles($uid, $uploadedFiles, $newsId);
            }
        }
        
        // ✅ 최적화 테이블 업데이트
        newsUpdateOptimizationData(
            $newsId,
            $uid,
            $updateData['category'] ?? null,
            $updateData['is_notice'] ?? 'N',
            $updateData['is_secret'] ?? 'N'
        );
        
        // ✅ Sitemap 캐시 무효화
        invalidateSitemapCache('news');
        
        $this->json([
            'success' => true,
            'message' => '뉴스가 수정되었습니다.',
            'redirect' => '/news/' . $newsId . '/view/' . $uid
        ]);
    }
    
    /**
     * 글삭제
     */
    public function delete($newsId, $uid) {
        // 뉴스 조회
        $post = $this->newsModel->getPost($uid);
        
        if (!$post || $post['news_id'] !== $newsId) {
            $this->json(['success' => false, 'message' => '존재하지 않는 뉴스입니다.'], 404);
            return;
        }
        
        // 삭제 권한 체크
        $canDelete = false;
        if (isLoggedIn() && isset($_SESSION['user_id'])) {
            if ($post['member_uid'] == $_SESSION['user_id'] || isAdmin()) {
                $canDelete = true;
            }
        }
        
        if (!$canDelete) {
            $this->json(['success' => false, 'message' => '삭제 권한이 없습니다.'], 403);
            return;
        }
        
        // 삭제 처리
        $result = $this->newsModel->deletePost($uid);
        
        if ($result) {
            // ✅ 최적화 테이블에서 삭제
            newsDeleteOptimizationData($newsId, $uid);
            
            // ✅ Sitemap 캐시 무효화
            invalidateSitemapCache('news');
            
            $this->json([
                'success' => true,
                'message' => '뉴스가 삭제되었습니다.',
                'redirect' => '/news/' . $newsId
            ]);
            return;
        } else {
            $this->json(['success' => false, 'message' => '삭제 중 오류가 발생했습니다.'], 500);
            return;
        }
    }
    
    /**
     * 댓글 작성
     */
    public function commentWrite($newsId, $postUid) {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->json(['success' => false, 'message' => '잘못된 요청입니다.'], 400);
        }
        
        // 뉴스 정보
        $news = $this->newsModel->getNewsInfo($newsId);
        
        if (!$news) {
            $this->json(['success' => false, 'message' => '존재하지 않는 뉴스입니다.'], 400);
        }
        
        // 권한 체크
        if ($news['comment_level'] > ($_SESSION['level'] ?? 0)) {
            $this->json(['success' => false, 'message' => '댓글 작성 권한이 없습니다.'], 403);
        }
        
        $content = cleanInput($this->post('content'));
        
        if (empty($content)) {
            $this->json(['success' => false, 'message' => '댓글 내용을 입력해주세요.'], 400);
        }
        
        // 세션 정보 확인 (디버깅)
        error_log("Session Info - user_id: " . ($_SESSION['user_id'] ?? 'not set') . 
                  ", nickname: " . ($_SESSION['nickname'] ?? 'not set') . 
                  ", is_admin: " . (isset($_SESSION['is_admin']) ? ($_SESSION['is_admin'] ? 'true' : 'false') : 'not set'));
        
        // 작성자 이름 결정 (우선순위: nickname > name > username > user_id > '비회원')
        $writerName = '비회원';
        if (isLoggedIn()) {
            $writerName = $_SESSION['nickname'] ?? 
                         $_SESSION['name'] ?? 
                         $_SESSION['username'] ?? 
                         ($_SESSION['user_id'] ? 'user_' . $_SESSION['user_id'] : '비회원');
        }
        
        $commentData = [
            'news_id' => $newsId,
            'data_uid' => $postUid,
            'content' => $content,
            'name' => $writerName,
            'member_uid' => $_SESSION['user_id'] ?? 0,
            'ip_address' => getClientIP()
        ];
        
        $commentId = $this->newsModel->createComment($commentData);
        
        if ($commentId) {
            $this->json(['success' => true, 'message' => '댓글이 등록되었습니다.']);
        } else {
            $this->json(['success' => false, 'message' => '댓글 등록 중 오류가 발생했습니다.'], 500);
        }
    }
    
    /**
     * 댓글 삭제
     */
    public function commentDelete($newsId, $postUid, $commentUid) {
        error_log("댓글 삭제 시작 - newsId: $newsId, postUid: $postUid, commentUid: $commentUid");
        error_log("세션 정보 - user_id: " . ($_SESSION['user_id'] ?? 'not set') . ", is_admin: " . (isAdmin() ? 'true' : 'false'));
        
        // 댓글 조회
        $comment = getUidData("SELECT * FROM news_comment WHERE uid = ?", [$commentUid]);
        
        if (!$comment) {
            error_log("댓글 삭제 실패 - 댓글을 찾을 수 없음: $commentUid");
            $this->json(['success' => false, 'message' => '존재하지 않는 댓글입니다.'], 404);
        }
        
        error_log("댓글 정보 - member_uid: " . $comment['member_uid']);
        
        // 삭제 권한 체크
        $canDelete = false;
        
        // 관리자는 모든 댓글 삭제 가능
        if (isAdmin()) {
            $canDelete = true;
            error_log("관리자 권한으로 삭제 허용");
        } 
        // 로그인한 사용자는 본인 댓글만 삭제 가능
        elseif (isLoggedIn() && isset($_SESSION['user_id'])) {
            if ($comment['member_uid'] == $_SESSION['user_id']) {
                $canDelete = true;
                error_log("본인 댓글 삭제 허용");
            }
        }
        // 비회원 댓글은 비밀번호 확인 필요 (추후 구현)
        
        if (!$canDelete) {
            error_log("댓글 삭제 권한 없음");
            $this->json(['success' => false, 'message' => '삭제 권한이 없습니다.'], 403);
        }
        
        $result = $this->newsModel->deleteComment($commentUid, $postUid);
        
        error_log("댓글 삭제 결과: " . ($result ? 'success' : 'failed'));
        
        if ($result) {
            $this->json(['success' => true, 'message' => '댓글이 삭제되었습니다.']);
        } else {
            $this->json(['success' => false, 'message' => '삭제 중 오류가 발생했습니다.'], 500);
        }
    }
    
    /**
     * 파일 다운로드
     */
    public function download($fileUid) {
        // news_upload 테이블에서 파일 정보 조회
        $file = getUidData("SELECT * FROM news_upload WHERE uid = ?", [$fileUid]);
        
        if (!$file) {
            echo '파일을 찾을 수 없습니다.';
            exit;
        }
        
        // 실제 파일 경로 (PUBLIC_PATH = /home/mvc/public)
        $filePath = PUBLIC_PATH . '/uploads/' . ltrim($file['filepath'], '/');
        
        if (!file_exists($filePath)) {
            echo '파일이 존재하지 않습니다: ' . $filePath;
            exit;
        }
        
        // 다운로드 횟수 증가
        getDbUpdate('news_upload', 
            ['download_count' => $file['download_count'] + 1], 
            'uid = ?', 
            [$fileUid]
        );
        
        // 파일 다운로드 헤더
        header('Content-Type: application/octet-stream');
        header('Content-Disposition: attachment; filename="' . $file['original_name'] . '"');
        header('Content-Length: ' . filesize($filePath));
        header('Cache-Control: must-revalidate');
        header('Pragma: public');
        
        readfile($filePath);
        exit;
    }
    
    /**
     * 댓글 목록 조회 (AJAX)
     */
    public function getComments($newsId, $postUid) {
        $comments = $this->newsModel->getComments($postUid);
        
        // 수정/삭제 권한 추가
        foreach ($comments as &$comment) {
            $canEdit = false;
            if (isLoggedIn() && isset($_SESSION['user_id'])) {
                if ($comment['member_uid'] == $_SESSION['user_id'] || isAdmin()) {
                    $canEdit = true;
                }
            }
            $comment['can_edit'] = $canEdit;
            $comment['reg_date'] = date('Y-m-d H:i', strtotime($comment['reg_date']));
        }
        
        $this->json([
            'success' => true,
            'comments' => $comments,
            'count' => count($comments)
        ]);
    }
    
    /**
     * 댓글 수정 (AJAX)
     */
    public function commentEdit($newsId, $postUid, $commentUid) {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->json(['success' => false, 'message' => '잘못된 요청입니다.'], 400);
        }
        
        // 댓글 조회
        $comment = getUidData("SELECT * FROM news_comment WHERE uid = ?", [$commentUid]);
        
        if (!$comment) {
            $this->json(['success' => false, 'message' => '존재하지 않는 댓글입니다.'], 404);
        }
        
        // 수정 권한 체크
        $canEdit = false;
        if (isLoggedIn() && isset($_SESSION['user_id'])) {
            if ($comment['member_uid'] == $_SESSION['user_id'] || isAdmin()) {
                $canEdit = true;
            }
        }
        
        if (!$canEdit) {
            $this->json(['success' => false, 'message' => '수정 권한이 없습니다.'], 403);
        }
        
        $content = cleanInput($this->post('content'));
        
        if (empty($content)) {
            $this->json(['success' => false, 'message' => '댓글 내용을 입력해주세요.'], 400);
        }
        
        // 댓글 수정
        $result = getDbUpdate('news_comment', ['content' => $content], 'uid = ?', [$commentUid]);
        
        if ($result !== false) {
            $this->json(['success' => true, 'message' => '댓글이 수정되었습니다.']);
        } else {
            $this->json(['success' => false, 'message' => '댓글 수정 중 오류가 발생했습니다.'], 500);
        }
    }
    
    /**
     * 좋아요 토글 (AJAX)
     */
    public function toggleLike($newsId, $postUid) {
        // 로그인 확인
        if (!isLoggedIn()) {
            $this->json(['success' => false, 'message' => '로그인이 필요합니다.'], 401);
        }
        
        $memberUid = $_SESSION['user_id'];
        
        // 이미 좋아요를 눌렀는지 확인
        $existingLike = getUidData(
            "SELECT * FROM post_likes WHERE post_uid = ? AND member_uid = ?",
            [$postUid, $memberUid]
        );
        
        if ($existingLike) {
            // 좋아요 취소
            getDbDelete('post_likes', 'uid = ?', [$existingLike['uid']]);
            
            // news_data의 like_count 감소
            $post = getUidData("SELECT like_count FROM news_data WHERE uid = ?", [$postUid]);
            $newCount = max(0, ($post['like_count'] ?? 1) - 1);
            getDbUpdate('news_data', ['like_count' => $newCount], 'uid = ?', [$postUid]);
            
            $liked = false;
            $message = '좋아요를 취소했습니다.';
        } else {
            // 좋아요 추가
            getDbInsert('post_likes', [
                'post_uid' => $postUid,
                'member_uid' => $memberUid
            ]);
            
            // news_data의 like_count 증가
            $post = getUidData("SELECT like_count FROM news_data WHERE uid = ?", [$postUid]);
            $newCount = ($post['like_count'] ?? 0) + 1;
            getDbUpdate('news_data', ['like_count' => $newCount], 'uid = ?', [$postUid]);
            
            $liked = true;
            $message = '좋아요를 눌렀습니다.';
        }
        
        // 현재 좋아요 수 조회
        $post = getUidData("SELECT like_count FROM news_data WHERE uid = ?", [$postUid]);
        $likeCount = $post['like_count'] ?? 0;
        
        $this->json([
            'success' => true,
            'message' => $message,
            'liked' => $liked,
            'like_count' => $likeCount
        ]);
    }
