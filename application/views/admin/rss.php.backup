<script>
// 게시판 전체 선택
function selectAllBbs() {
    document.querySelectorAll('.bbs-checkbox').forEach(cb => cb.checked = true);
}

// 게시판 전체 해제
function deselectAllBbs() {
    document.querySelectorAll('.bbs-checkbox').forEach(cb => cb.checked = false);
}

// 뉴스 전체 선택
function selectAllNews() {
    document.querySelectorAll('.news-checkbox').forEach(cb => cb.checked = true);
}

// 뉴스 전체 해제
function deselectAllNews() {
    document.querySelectorAll('.news-checkbox').forEach(cb => cb.checked = false);
}

// 클립보드 복사
function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
        showAlert('URL이 클립보드에 복사되었습니다.', 'success');
    }).catch(err => {
        console.error('복사 실패:', err);
        showAlert('복사에 실패했습니다.', 'danger');
    });
}

// 알림 표시
function showAlert(message, type = 'info') {
    const alertBox = document.getElementById('alertMessage');
    alertBox.className = `alert alert-${type}`;
    alertBox.textContent = message;
    alertBox.classList.remove('d-none');
    
    setTimeout(() => {
        alertBox.classList.add('d-none');
    }, 3000);
}

// RSS 설정 저장
function saveRssSettings() {
    const rssEnabled = document.getElementById('rssEnabled').value;
    const rssItemLimit = document.getElementById('rssItemLimit').value;
    const rssExtractDays = document.getElementById('rssExtractDays').value;
    const rssBbsEnabled = document.getElementById('rssBbsEnabled').checked ? 'Y' : 'N';
    const rssNewsEnabled = document.getElementById('rssNewsEnabled').checked ? 'Y' : 'N';
    
    // 선택된 게시판 목록
    const selectedBbs = Array.from(document.querySelectorAll('.bbs-checkbox:checked'))
        .map(cb => cb.value)
        .join(',');
    
    // 선택된 뉴스 목록
    const selectedNews = Array.from(document.querySelectorAll('.news-checkbox:checked'))
        .map(cb => cb.value)
        .join(',');
    
    // AJAX 요청
    fetch('/admin/rss', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            action: 'save',
            rss_enabled: rssEnabled,
            rss_item_limit: rssItemLimit,
            rss_extract_days: rssExtractDays,
            rss_bbs_enabled: rssBbsEnabled,
            rss_news_enabled: rssNewsEnabled,
            rss_bbs_list: selectedBbs,
            rss_news_list: selectedNews
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('RSS 설정이 저장되었습니다.', 'success');
        } else {
            showAlert('저장에 실패했습니다: ' + (data.message || '알 수 없는 오류'), 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showAlert('저장 중 오류가 발생했습니다.', 'danger');
    });
}

// RSS 재생성
function regenerateRss() {
    if (!confirm('RSS 피드를 재생성하시겠습니까?')) {
        return;
    }
    
    showAlert('RSS 피드 생성 중...', 'info');
    
    fetch('/admin/rss', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            action: 'regenerate'
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            let message = 'RSS 피드가 생성되었습니다.\n';
            if (data.results) {
                Object.keys(data.results).forEach(key => {
                    const result = data.results[key];
                    if (result.success) {
                        message += `✓ ${key}: ${result.file}\n`;
                    } else {
                        message += `✗ ${key}: ${result.error}\n`;
                    }
                });
            }
            showAlert(message, 'success');
        } else {
            showAlert('RSS 생성에 실패했습니다: ' + (data.message || '알 수 없는 오류'), 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showAlert('RSS 생성 중 오류가 발생했습니다.', 'danger');
    });
}
</script>

