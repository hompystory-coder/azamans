                'trend': 'stable',  # up/down/stable
                'change': 0.0,
                'previous': 3.0,
                'source': '통계청 KOSIS',
                'country': 'KR'
            }
        """
        if not self.unemployment_fetcher:
            logger.warning("⚠️ 실업률 데이터 사용 불가")
            return None
        
        try:
            data = self.unemployment_fetcher.get_unemployment_data(country)
            logger.info(f"✅ {country} 실업률: {data['rate']}% ({data['date']})")
            return data
        except Exception as e:
            logger.error(f"❌ 실업률 조회 오류: {e}")
            return None
    
    def get_stock_data(self, ticker: str, start_date: str = "2020-01-01", end_date: Optional[str] = None) -> pd.DataFrame:
        """
        주가 데이터 가져오기 (기존 yfinance 유지)
        
        Args:
            ticker: 종목 코드 (예: "TSLA", "005930.KS")
            start_date: 시작일 (YYYY-MM-DD)
            end_date: 종료일 (YYYY-MM-DD), None이면 오늘
        
        Returns:
            DataFrame with OHLCV data
        """
        if end_date is None:
            end_date = datetime.now().strftime("%Y-%m-%d")
        
        logger.info(f"📊 {ticker} 히스토리 데이터 수집 중... ({start_date} ~ {end_date})")
        
        try:
            stock = yf.Ticker(ticker)
            df = stock.history(start=start_date, end=end_date)
            
            if df.empty:
                logger.warning(f"⚠️ {ticker} 데이터 없음")
                return pd.DataFrame()
            
            # 월별 집계용 컬럼 추가
            df['Year'] = df.index.year
            df['Month'] = df.index.month
            
            logger.info(f"✅ {ticker} 데이터 수집 완료: {len(df)} 행")
            return df
        
        except Exception as e:
            logger.error(f"❌ {ticker} 데이터 수집 오류: {e}")
            return pd.DataFrame()
    
    def get_stock_info(self, ticker: str) -> Dict:
        """종목 기본 정보 (기존 유지)"""
        try:
            stock = yf.Ticker(ticker)
            info = stock.info
            
            return {
                'name': info.get('longName', ticker),
                'sector': info.get('sector', 'N/A'),
                'industry': info.get('industry', 'N/A'),
                'country': info.get('country', 'N/A'),
                'marketCap': info.get('marketCap', 0),
                'currency': info.get('currency', 'USD'),
                'description': info.get('longBusinessSummary', '')
            }
        except Exception as e:
            logger.error(f"❌ {ticker} 정보 수집 오류: {e}")
            return {'name': ticker}
    
    def get_monthly_summary(self, df: pd.DataFrame) -> pd.DataFrame:
        """월별 요약 데이터 (기존 유지)"""
        if df.empty:
            return pd.DataFrame()
        
        monthly = df.groupby(['Year', 'Month']).agg({
            'Open': 'first',
            'High': 'max',
            'Low': 'min',
            'Close': 'last',
            'Volume': 'sum'
        }).reset_index()
        
        # 수익률 계산
        monthly['Returns'] = monthly['Close'].pct_change() * 100
        monthly['Date'] = pd.to_datetime(monthly[['Year', 'Month']].assign(DAY=1))
        
        return monthly
    
