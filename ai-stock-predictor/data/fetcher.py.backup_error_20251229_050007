    def is_korean_stock(self, ticker: str) -> bool:
        """한국 주식 여부 판단"""
        return ticker.endswith('.KS') or ticker.endswith('.KQ') or (ticker.isdigit() and len(ticker) == 6)
    
    def get_naver_realtime(self, ticker: str) -> Dict:
        """
        네이버 금융 실시간 주가 크롤링 (직접 구현)
        
        Returns:
            실시간 주가 정보 dict 또는 None (실패 시)
        """
        # 종목 코드 정규화
        clean_ticker = ticker.replace('.KS', '').replace('.KQ', '')
        
        url = f"https://finance.naver.com/item/main.naver?code={clean_ticker}"
        
        try:
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            }
            
            response = requests.get(url, headers=headers, timeout=10)
            
            if response.status_code != 200:
                return None
            
            soup = BeautifulSoup(response.text, 'html.parser')
            
            # 현재가 파싱
            price_elem = soup.select_one('.no_today .blind')
            if not price_elem:
                return None
            
            current_price = int(price_elem.text.replace(',', ''))
            
            # 전일 대비 파싱
            change_elem = soup.select_one('.no_exday .blind')
            change = 0
            if change_elem:
                change_text = change_elem.text.replace(',', '').replace('+', '').replace('-', '')
                if change_text.isdigit():
                    change = int(change_text)
                    # 부호 확인
                    if '하락' in soup.select_one('.no_exday').text:
                        change = -change
            
            # 등락률 파싱
            rate_elem = soup.select_one('.no_exday .blind:nth-of-type(2)')
            change_pct = 0.0
            if rate_elem:
                rate_text = rate_elem.text.replace('%', '').replace('+', '').replace('-', '')
                try:
                    change_pct = float(rate_text)
                    if '하락' in soup.select_one('.no_exday').text:
                        change_pct = -change_pct
                except:
                    pass
            
            # 전일 종가
            previous_close = current_price - change
            
            # 시가/고가/저가/거래량 파싱
            today_table = soup.select('.new_totalinfo .date_table tbody tr')
            
            시가 = 0
            고가 = 0
            저가 = 0
            거래량 = 0
            
            for tr in today_table:
                th = tr.select_one('th')
                td = tr.select_one('td')
                
                if not th or not td:
                    continue
                
                key = th.text.strip()
                value = td.text.strip().replace(',', '')
                
                try:
                    if '시가' in key:
                        시가 = int(value)
                    elif '고가' in key:
                        고가 = int(value)
                    elif '저가' in key:
                        저가 = int(value)
                    elif '거래량' in key:
                        거래량 = int(value)
                except:
                    pass
            
            # 종목명 파싱
            name_elem = soup.select_one('.wrap_company h2 a')
            name = name_elem.text.strip() if name_elem else clean_ticker
            
            # 시장 구분 (코스피/코스닥)
            market = 'KOSPI' if ticker.endswith('.KS') else 'KOSDAQ'
            
            result = {
                'price': current_price,
                'change': change,
                'change_pct': change_pct,
                'volume': 거래량,
                'high': 고가,
                'low': 저가,
                'open': 시가,
                'previous_close': previous_close,
                'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
                'source': 'NAVER',
                'is_realtime': True,
                'delay': '실시간 (15초 이내)',
                'market': market,
                'company_name': name
            }
            
            logger.info(f"✅ {ticker} 네이버 실시간: {result['price']:,.0f}원 ({result['change_pct']:+.2f}%)")
            return result
            
        except Exception as e:
            logger.error(f"❌ 네이버 크롤링 실패: {e}")
            return None
    
    def get_realtime_price(self, ticker: str) -> Dict:
        """
        실시간 가격 조회 (통합)
        
        한국 주식 → 네이버 크롤링 (진짜 실시간)
        미국 주식 → yfinance (15-20분 지연)
        
        Returns:
            {
                'price': 119100.0,
                'change': 2100.0,
                'change_pct': 1.79,
                'volume': 15010663,
                'high': 119700.0,
                'low': 118200.0,
                'open': 119400.0,
                'previous_close': 117000.0,
                'timestamp': '2025-12-29 13:30:00',
                'source': 'NAVER' 또는 'yfinance',
                'is_realtime': True/False,
                'delay': '실시간' 또는 '15-20분 지연'
            }
        """
        logger.info(f"📊 {ticker} 실시간 가격 조회 중...")
        
        # 한국 주식 → 네이버
        if self.is_korean_stock(ticker):
            naver_data = self.get_naver_realtime(ticker)
            
            if naver_data:
                return naver_data
            
            logger.warning(f"⚠️ 네이버 크롤링 실패, yfinance로 폴백")
        
        # 미국 주식 또는 네이버 실패 시 → yfinance
        try:
            stock = yf.Ticker(ticker)
            info = stock.info
            hist = stock.history(period='2d')
            
            if not hist.empty:
                current = hist.iloc[-1]
                previous = hist.iloc[-2] if len(hist) > 1 else current
                
                current_price = current['Close']
                previous_close = previous['Close']
                change = current_price - previous_close
                change_pct = (change / previous_close) * 100 if previous_close else 0
                
                result = {
                    'price': round(current_price, 2),
                    'change': round(change, 2),
                    'change_pct': round(change_pct, 2),
                    'volume': int(current['Volume']),
                    'high': round(current['High'], 2),
                    'low': round(current['Low'], 2),
                    'open': round(current['Open'], 2),
                    'previous_close': round(previous_close, 2),
                    'timestamp': current.name.strftime('%Y-%m-%d %H:%M:%S'),
                    'source': 'yfinance',
                    'is_realtime': False,
                    'delay': '15-20분 지연',
                    'market': info.get('exchange', 'N/A'),
                    'company_name': info.get('longName', ticker)
                }
                
                logger.info(f"✅ {ticker} yfinance: ${result['price']:,.2f} ({result['change_pct']:+.2f}%)")
                return result
        
        except Exception as e:
            logger.error(f"❌ {ticker} 가격 조회 실패: {e}")
        
        # 완전 실패 시 빈 데이터
        return {
            'price': 0,
            'change': 0,
            'change_pct': 0,
            'volume': 0,
            'high': 0,
            'low': 0,
            'open': 0,
            'previous_close': 0,
            'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'source': 'N/A',
            'is_realtime': False,
            'delay': 'N/A',
            'market': 'N/A',
            'company_name': ticker
        }
    
